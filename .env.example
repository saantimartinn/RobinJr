# REQUIRED — núcleo de la aplicación
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL — seguridad HTTP y URL pública (URL/DEPLOY_* las aporta Netlify)
ALLOWED_ORIGINS=
PUBLIC_BASE_URL=

# OPTIONAL — nombres de buckets; deben existir previamente
SUPABASE_BUCKET=
SUPABASE_DOCS_BUCKET=

# OPTIONAL — IA/OCR; requeridas solo para endpoints que usan Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# REQUIRED IN PRODUCTION — Revolut Merchant
PAYMENT_PROVIDER=revolut
REVOLUT_MERCHANT_SECRET_KEY=
# Sandbox: https://sandbox-merchant.revolut.com · Producción: https://merchant.revolut.com
REVOLUT_API_BASE=
REVOLUT_API_VERSION=2026-03-12
REVOLUT_WEBHOOK_SIGNING_SECRET=

# OPTIONAL — email; sin API key los intentos quedan registrados
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_INBOXES=
TEAM_EMAIL=

# OPTIONAL GROUP — Google Drive/Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Opcionales: sobrescriben el workbook CASH 2026/27 y la pestaña 26-27 por defecto
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_GID=
GOOGLE_SHEETS_TAB=

# OPTIONAL GROUP — Calendar/Meet por asesor; client ID/secret son compartidos
GOOGLE_REFRESH_TOKEN_NOEL=
GOOGLE_REFRESH_TOKEN_MANUEL=
GOOGLE_REFRESH_TOKEN_MARIA=

# OPTIONAL — disponibilidad de reservas
BOOKING_AVAIL_TITLE=
BOOKING_MAX_DAYS=
BOOKING_SLOT_MIN=

# REQUIRED IF MEET INGESTION IS ENABLED
MEET_WEBHOOK_SECRET=
MEET_POLL_LOOKBACK_HOURS=

# OPTIONAL GROUP — Notion; configurar al menos un secreto de webhook
NOTION_VERIFICATION_TOKEN=
NOTION_WEBHOOK_SECRET=
NOTION_RESPONSABLE_MAP=
# REQUIRED IF NOTION CREATES USERS
NOTION_BOOTSTRAP_PASSWORD=
# REQUIRED WHEN THE NEW ADMIN CRM CREATES CLIENTS
ROBIN_ADMIN_SYNC_SECRET=

# OPTIONAL GROUP — Holded
HOLDED_API_PAT=
HOLDED_ACCOUNT_GENERAL=
HOLDED_ACCOUNT_DELFT=
HOLDED_ACCOUNT_MENTORIA=
HOLDED_ACCOUNT_LLEGADA=
